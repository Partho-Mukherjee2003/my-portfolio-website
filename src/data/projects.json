      "apiBaseUrl": "https://wedplan-server-henna.vercel.app",
      "apiEndpoints": [
        {
          "method": "GET",
          "path": "/",
          "description": "Server health check",
          "auth": "public"
        },
        {
          "method": "GET",
          "path": "/services",
          "description": "All services (optional ?status= and ?vendorId= filters)",
          "auth": "public"
        },
        {
          "method": "GET",
          "path": "/services/:id",
          "description": "One service by ID",
          "auth": "public"
        },
        {
          "method": "POST",
          "path": "/bookings",
          "description": "Create a booking request (customer ID from token)",
          "auth": "jwt (customer)"
        },
        {
          "method": "GET",
          "path": "/bookings",
          "description": "Get bookings (optional ?customerId= / ?vendorId= filters)",
          "auth": "jwt"
        },
        {
          "method": "PATCH",
          "path": "/bookings/:id",
          "description": "Cancel (customer) or accept/reject (vendor) a pending booking",
          "auth": "jwt"
        },
        {
          "method": "POST",
          "path": "/services",
          "description": "Add a service (vendor ID and plan from token; free plan max 3 active)",
          "auth": "jwt (vendor)"
        },
        {
          "method": "PATCH",
          "path": "/services/:id",
          "description": "Update own service",
          "auth": "jwt (vendor)"
        },
        {
          "method": "DELETE",
          "path": "/services/:id",
          "description": "Delete a service (vendor: own only; admin: any)",
          "auth": "jwt (vendor/admin)"
        },
        {
          "method": "GET",
          "path": "/users",
          "description": "All users (used for vendor info, plan and blocked checks)",
          "auth": "public"
        },
        {
          "method": "PATCH",
          "path": "/users/:id/block",
          "description": "Block or unblock a user",
          "auth": "jwt (admin)"
        },
        {
          "method": "PATCH",
          "path": "/services/:id/status",
          "description": "Approve or reject a service",
          "auth": "jwt (admin)"
        },
        {
          "method": "GET",
          "path": "/transactions",
          "description": "All Stripe transactions",
          "auth": "jwt (admin)"
        },
        {
          "method": "POST",
          "path": "/create-checkout-session",
          "description": "Create a Stripe Checkout session for the Premium plan",
          "auth": "jwt (vendor)"
        },
        {
          "method": "POST",
          "path": "/webhook",
          "description": "Stripe webhook: activates Premium and records the transaction",
          "auth": "stripe-signature"
        }
      ],
      "statusCodes": {
        "200/201": "Success / created",
        "400": "Invalid ID, missing fields or invalid status change",
        "401": "Missing, invalid or expired token",
        "403": "Forbidden: wrong role, blocked account, own-service booking or free-plan limit",
        "404": "Service, booking or user not found",
        "500": "Server error"
      },
      "dataModels": {
        "user": [
          "_id",
          "name",
          "email",
          "image",
          "role (customer | vendor | admin)",
          "isBlocked",
          "businessName (vendor)",
          "subscriptionPlan (free | premium)",
          "subscriptionExpiresAt"
        ],
        "services": [
          "_id",
          "vendorId",
          "serviceName",
          "category",
          "description",
          "price",
          "location",
          "images",
          "status (pending | approved | rejected)",
          "createdAt"
        ],
        "bookings": [
          "_id",
          "serviceId",
          "vendorId",
          "customerId",
          "eventDate",
          "eventLocation",
          "message",
          "status (pending | accepted | rejected | cancelled)",
          "createdAt"
        ],
        "transactions": [
          "_id",
          "vendorId",
          "plan",
          "amount",
          "currency",
          "stripeSessionId",
          "stripeSubscriptionId",
          "status",
          "createdAt"
        ]
