            "user (Better Auth)"
          ]
        },
        "deployment": {
          "client": "Vercel",
          "server": "Vercel"
        }
      },
      "architecture": {
        "pattern": "Separate client and server repositories",
        "authFlow": [
          "User registers or logs in with Better Auth (email/password or Google)",
          "Proxy checks the session cookie before opening private pages",
          "Client requests a JWT and sends it as Authorization: Bearer <token>",
          "Server verifies the token via JWKS (signature, issuer, audience)",
          "Server loads the user by the token subject, checks role and blocked status, and uses the verified user ID for all ownership checks"
        ]
      },
